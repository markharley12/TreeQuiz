# Anchored on purpose: an unanchored rule also matches nested directories of the
# same name, which is how TaxoQuiz once dropped its packaged data from a wheel.
/.venv/
/dist/
/build/
# Downloads made by datagen/ — the sources a dataset is built from. Regenerable,
# and some are large; the built dataset under datasets/ is what is committed.
/datagen/_cache/
__pycache__/
*.pyc
node_modules/
.claude/

# Built by datagen/build_animals_full.py and published as a GitHub Release (the
# manifest's `release`); only the hand-written manifest is committed.
/datasets/animals/*
!/datasets/animals/manifest.json
